{
  "name": "crm-multiplica",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -F @crm/shared build && concurrently -k -n shared,api,web -c gray,blue,green \"pnpm -F @crm/shared dev\" \"pnpm -F @crm/api dev\" \"pnpm -F @crm/web dev\"",
    "worker:dev": "pnpm -F @crm/api worker:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:integration": "pnpm -F @crm/api test:integration",
    "db:setup": "pnpm -F @crm/api db:setup",
    "db:migrate": "pnpm -F @crm/api db:migrate",
    "db:deploy": "pnpm -F @crm/api db:deploy",
    "db:seed": "pnpm -F @crm/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.1.9"
    }
  }
}
