# Variables de producción. Copiar a deploy/.env (NO se versiona) y completar.
# Generar contraseñas: openssl rand -base64 24 | tr -d '/+='

# Imágenes (las publica el workflow "Release" en GHCR). Fijar una versión, no "latest".
CRM_API_IMAGE=ghcr.io/mauri1704/crm_multiplica-api:v1.0.0
CRM_WEB_IMAGE=ghcr.io/mauri1704/crm_multiplica-web:v1.0.0

# Base de datos
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# URL pública (https) de la aplicación: va en los enlaces de los correos.
WEB_URL=https://crm.ejemplo.com
# Correo saliente: smtp://usuario:clave@host:587
SMTP_URL=
MAIL_FROM="CRM Multiplica <no-reply@ejemplo.com>"

# Puertos locales (solo 127.0.0.1; el proxy del servidor publica el dominio)
WEB_PORT=8081
API_PORT=3001

# Respaldos
BACKUP_DIR=/var/backups/crm
BACKUP_RETENTION_DAYS=30
# Copia fuera del servidor (opcional): destino de rsync, p. ej. usuario@host:/ruta
BACKUP_REMOTE=
