// CRM Multiplica — modelo de datos.
// Convenciones (docs/plan/02-modelo-datos.md): tablas y columnas en snake_case, UUID v7,
// organization_id en toda tabla de negocio + Row-Level Security (ver migraciones).
// Las tablas de identidad (organizations, users, sessions, password_reset_tokens) no tienen RLS:
// el login las lee antes de conocer la organización; sus repositorios filtran organization_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Organización, usuarios y sesiones (sin RLS)
// ---------------------------------------------------------------------------

model Organization {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String   @db.VarChar(120)
  legalName        String?  @map("legal_name") @db.VarChar(200)
  taxId            String?  @map("tax_id") @db.VarChar(20)
  baseCurrencyCode String   @default("PEN") @map("base_currency_code") @db.Char(3)
  /// Parámetros generales (OrganizationSettings en @crm/shared). Se valida con Zod al leer y escribir.
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("organizations")
}

model User {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  /// Siempre en minúsculas (lo normaliza el esquema Zod). Único en todo el sistema.
  email             String    @unique @db.VarChar(254)
  name              String    @db.VarChar(120)
  passwordHash      String    @map("password_hash")
  roleId            String    @map("role_id") @db.Uuid
  active            Boolean   @default(true)
  theme             String    @default("system") @db.VarChar(10)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?   @map("created_by_id") @db.Uuid

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role           Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  teams          TeamMember[]
  supervises     Team[]               @relation("TeamSupervisor")
  ownedCompanies Company[]            @relation("CompanyOwner")
  ownedContacts  Contact[]            @relation("ContactOwner")

  ownedLeads Lead[] @relation("LeadOwner")
  ownedDeals Deal[] @relation("DealOwner")

  @@index([organizationId, active])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 del token de la cookie. El token en claro nunca se guarda.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Equipos, roles y permisos (RLS)
// ---------------------------------------------------------------------------

model Team {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  description    String?   @db.VarChar(500)
  supervisorId   String?   @map("supervisor_id") @db.Uuid
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  supervisor User?        @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  members    TeamMember[]

  @@index([organizationId, deletedAt, name])
  @@map("teams")
}

model TeamMember {
  organizationId String   @map("organization_id") @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([organizationId, userId])
  @@map("team_members")
}

model Role {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// ADMIN | SUPERVISOR | SALES para los roles del sistema (no se borran); null en roles creados.
  systemKey      String?  @map("system_key") @db.VarChar(20)
  name           String   @db.VarChar(60)
  description    String?  @db.VarChar(300)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       User[]

  @@unique([organizationId, systemKey])
  @@unique([organizationId, name])
  @@map("roles")
}

model RolePermission {
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  module         String @db.VarChar(40)
  action         String @db.VarChar(20)
  /// NONE | OWN | TEAM | ALL
  scope          String @db.VarChar(10)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, module, action])
  @@index([organizationId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Configuración (RLS)
// ---------------------------------------------------------------------------

model Pipeline {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// LEAD | DEAL
  entityType     String   @map("entity_type") @db.VarChar(10)
  name           String   @db.VarChar(80)
  position       Int      @default(0)
  isDefault      Boolean  @default(false) @map("is_default")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stages Stage[]

  leads Lead[]
  deals Deal[]

  @@unique([organizationId, entityType, name])
  @@map("pipelines")
}

model Stage {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  name           String   @db.VarChar(60)
  position       Int
  color          String   @db.Char(7)
  /// OPEN | WON | LOST | CONVERTED
  kind           String   @db.VarChar(10)
  probability    Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  leads Lead[]
  deals Deal[]

  @@index([organizationId, pipelineId, position])
  @@map("stages")
}

model Priority {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  color          String   @db.Char(7)
  icon           String   @db.VarChar(20)
  /// Mayor = más urgente.
  rank           Int
  isDefault      Boolean  @default(false) @map("is_default")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]
  deals Deal[]

  @@unique([organizationId, name])
  @@map("priorities")
}

model LeadSource {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]

  @@unique([organizationId, name])
  @@map("lead_sources")
}

model LossReason {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// LEAD | DEAL
  entityType     String   @map("entity_type") @db.VarChar(10)
  name           String   @db.VarChar(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]
  deals Deal[]

  @@unique([organizationId, entityType, name])
  @@map("loss_reasons")
}

model DocumentType {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(10)
  name           String   @db.VarChar(100)
  /// Expresión regular que debe cumplir el número de documento.
  pattern        String?  @db.VarChar(200)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies Company[]
  contacts  Contact[]

  @@unique([organizationId, code])
  @@map("document_types")
}

model EconomicSector {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies Company[]

  @@unique([organizationId, name])
  @@map("economic_sectors")
}

model TaskStatus {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  color          String   @db.Char(7)
  /// OPEN | IN_PROGRESS | REVIEW | DONE | CANCELED
  category       String   @db.VarChar(15)
  position       Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, name])
  @@map("task_statuses")
}

model CustomFieldDefinition {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(20)
  key            String   @db.VarChar(40)
  label          String   @db.VarChar(100)
  type           String   @db.VarChar(15)
  options        Json     @default("[]")
  required       Boolean  @default(false)
  section        String?  @db.VarChar(60)
  helpText       String?  @map("help_text") @db.VarChar(200)
  position       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, entityType, key])
  @@map("custom_field_definitions")
}

/// Contadores de códigos correlativos (D-11). Se incrementan con UPDATE … RETURNING (atómico).
model Sequence {
  organizationId String @map("organization_id") @db.Uuid
  entityType     String @map("entity_type") @db.VarChar(20)
  nextValue      Int    @default(1) @map("next_value")

  @@id([organizationId, entityType])
  @@map("sequences")
}

// ---------------------------------------------------------------------------
// Historial, auditoría, notificaciones y papelera (RLS)
// ---------------------------------------------------------------------------

/// Solo inserción: el rol de la aplicación no tiene UPDATE ni DELETE (ver migración).
model RecordHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") @db.VarChar(20)
  entityId       String   @map("entity_id") @db.Uuid
  action         String   @db.VarChar(20)
  /// { campo: { from, to } }
  changes        Json     @default("{}")
  userId         String?  @map("user_id") @db.Uuid
  correlationId  String?  @map("correlation_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, entityType, entityId, createdAt])
  @@map("record_history")
}

/// Solo inserción.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  event          String   @db.VarChar(40)
  userId         String?  @map("user_id") @db.Uuid
  entityType     String?  @map("entity_type") @db.VarChar(20)
  entityId       String?  @map("entity_id") @db.Uuid
  ip             String?  @db.VarChar(64)
  details        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([organizationId, event, createdAt])
  @@map("audit_log")
}

model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(40)
  title          String    @db.VarChar(200)
  link           String?   @db.VarChar(300)
  entityType     String?   @map("entity_type") @db.VarChar(20)
  entityId       String?   @map("entity_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, userId, readAt, createdAt])
  @@map("notifications")
}

/// Índice transversal de la papelera. El registro sigue en su tabla con deleted_at.
model TrashEntry {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entityType     String    @map("entity_type") @db.VarChar(20)
  entityId       String    @map("entity_id") @db.Uuid
  displayName    String    @map("display_name") @db.VarChar(300)
  code           String?   @db.VarChar(30)
  /// Responsable del registro al eliminarlo (para el alcance "propios").
  ownerId        String?   @map("owner_id") @db.Uuid
  deletedById    String    @map("deleted_by_id") @db.Uuid
  deletedAt      DateTime  @default(now()) @map("deleted_at") @db.Timestamptz(3)
  /// IN_TRASH | RESTORED | PURGED
  status         String    @default("IN_TRASH") @db.VarChar(10)
  relations      Json      @default("{}")
  purgeAfter     DateTime  @map("purge_after") @db.Timestamptz(3)
  cascadeGroupId String?   @map("cascade_group_id") @db.Uuid
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, entityType, entityId])
  @@map("trash_entries")
}

// ---------------------------------------------------------------------------
// Fase 2 — Monedas y tipos de cambio (RLS)
// ---------------------------------------------------------------------------

model Currency {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// ISO 4217
  code           String   @db.Char(3)
  name           String   @db.VarChar(60)
  symbol         String   @db.VarChar(5)
  decimals       Int      @default(2)
  /// BEFORE | AFTER
  symbolPosition String   @default("BEFORE") @map("symbol_position") @db.VarChar(6)
  isBase         Boolean  @default(false) @map("is_base")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ratesFrom ExchangeRate[] @relation("RateFrom")
  ratesTo   ExchangeRate[] @relation("RateTo")
  products  Product[]

  leads Lead[]
  deals Deal[]

  @@unique([organizationId, code])
  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Fecha de vigencia
  rateDate       DateTime @map("rate_date") @db.Date
  fromCurrency   String   @map("from_currency") @db.Char(3)
  toCurrency     String   @map("to_currency") @db.Char(3)
  /// 1 unidad de origen = rate unidades de destino
  rate           Decimal  @db.Decimal(20, 10)
  /// ACTIVE | INACTIVE
  status         String   @default("ACTIVE") @db.VarChar(10)
  /// MANUAL | IMPORT
  source         String   @default("MANUAL") @db.VarChar(10)
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  from    Currency              @relation("RateFrom", fields: [organizationId, fromCurrency], references: [organizationId, code], onDelete: Restrict)
  to      Currency              @relation("RateTo", fields: [organizationId, toCurrency], references: [organizationId, code], onDelete: Restrict)
  history ExchangeRateHistory[]

  @@index([organizationId, fromCurrency, toCurrency, rateDate(sort: Desc)])
  @@index([organizationId, rateDate])
  @@map("exchange_rates")
}

/// Solo inserción: cada modificación de una tasa.
model ExchangeRateHistory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  exchangeRateId String   @map("exchange_rate_id") @db.Uuid
  oldRate        Decimal? @map("old_rate") @db.Decimal(20, 10)
  newRate        Decimal? @map("new_rate") @db.Decimal(20, 10)
  oldStatus      String?  @map("old_status") @db.VarChar(10)
  newStatus      String?  @map("new_status") @db.VarChar(10)
  reason         String   @db.VarChar(300)
  userId         String?  @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  exchangeRate ExchangeRate @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)

  @@index([organizationId, exchangeRateId, createdAt])
  @@map("exchange_rate_history")
}

// ---------------------------------------------------------------------------
// Fase 2 — Productos, compañías y contactos (RLS)
// ---------------------------------------------------------------------------

model ProductCategory {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@unique([organizationId, name])
  @@map("product_categories")
}

model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sku            String    @db.VarChar(60)
  skuNorm        String    @map("sku_norm") @db.VarChar(60)
  name           String    @db.VarChar(200)
  nameNorm       String    @map("name_norm") @db.VarChar(200)
  description    String?
  categoryId     String?   @map("category_id") @db.Uuid
  price          Decimal   @db.Decimal(20, 4)
  currencyCode   String    @map("currency_code") @db.Char(3)
  maxDiscountPct Decimal   @default(0) @map("max_discount_pct") @db.Decimal(5, 2)
  active         Boolean   @default(true)
  customFields   Json      @default("{}") @map("custom_fields")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  currency Currency         @relation(fields: [organizationId, currencyCode], references: [organizationId, code], onDelete: Restrict)

  leadProducts LeadProduct[]
  dealProducts DealProduct[]

  @@index([organizationId, deletedAt, name])
  @@map("products")
}

model Company {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(20)
  legalName      String    @map("legal_name") @db.VarChar(200)
  tradeName      String?   @map("trade_name") @db.VarChar(200)
  taxIdTypeId    String?   @map("tax_id_type_id") @db.Uuid
  taxId          String?   @map("tax_id") @db.VarChar(20)
  taxIdNorm      String?   @map("tax_id_norm") @db.VarChar(20)
  sectorId       String?   @map("sector_id") @db.Uuid
  address        String?   @db.VarChar(300)
  city           String?   @db.VarChar(100)
  country        String    @default("PE") @db.Char(2)
  email          String?   @db.VarChar(254)
  emailNorm      String?   @map("email_norm") @db.VarChar(254)
  phone          String?   @db.VarChar(30)
  phoneNorm      String?   @map("phone_norm") @db.VarChar(30)
  website        String?   @db.VarChar(200)
  ownerId        String?   @map("owner_id") @db.Uuid
  notes          String?
  customFields   Json      @default("{}") @map("custom_fields")
  /// Texto normalizado para búsqueda (razón social, nombre comercial, RUC, código)
  searchNorm     String    @default("") @map("search_norm")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  owner           User?            @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  taxIdType       DocumentType?    @relation(fields: [taxIdTypeId], references: [id], onDelete: Restrict)
  sector          EconomicSector?  @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  contacts        Contact[]
  relatedContacts ContactCompany[]

  leads    Lead[]
  deals    Deal[]
  comments Comment[]

  @@index([organizationId, deletedAt, legalName])
  @@index([organizationId, ownerId])
  @@map("companies")
}

model Contact {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(20)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String?   @map("last_name") @db.VarChar(100)
  documentTypeId String?   @map("document_type_id") @db.Uuid
  documentNumber String?   @map("document_number") @db.VarChar(30)
  documentNorm   String?   @map("document_norm") @db.VarChar(30)
  phone          String?   @db.VarChar(30)
  phoneNorm      String?   @map("phone_norm") @db.VarChar(30)
  email          String?   @db.VarChar(254)
  emailNorm      String?   @map("email_norm") @db.VarChar(254)
  jobTitle       String?   @map("job_title") @db.VarChar(100)
  companyId      String?   @map("company_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  notes          String?
  customFields   Json      @default("{}") @map("custom_fields")
  searchNorm     String    @default("") @map("search_norm")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  owner            User?            @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  documentType     DocumentType?    @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  relatedCompanies ContactCompany[]

  leads        Lead[]
  dealContacts DealContact[]
  comments     Comment[]

  @@index([organizationId, deletedAt, firstName])
  @@index([organizationId, ownerId])
  @@index([organizationId, companyId])
  @@map("contacts")
}

model ContactCompany {
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  jobTitle       String?  @map("job_title") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([contactId, companyId])
  @@index([organizationId, companyId])
  @@map("contact_companies")
}

// ---------------------------------------------------------------------------
// Fase 2 — Importaciones (RLS)
// ---------------------------------------------------------------------------

model ImportJob {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entityType     String    @map("entity_type") @db.VarChar(30)
  fileName       String    @map("file_name") @db.VarChar(255)
  /// xlsx | csv
  format         String    @db.VarChar(5)
  /// Ruta relativa a STORAGE_DIR
  filePath       String    @map("file_path") @db.VarChar(300)
  /// UPLOADED | COMPLETED | FAILED
  status         String    @default("UPLOADED") @db.VarChar(12)
  headers        Json      @default("[]")
  mapping        Json      @default("{}")
  duplicateMode  String    @default("SKIP") @map("duplicate_mode") @db.VarChar(10)
  totalRows      Int       @default(0) @map("total_rows")
  validRows      Int       @default(0) @map("valid_rows")
  invalidRows    Int       @default(0) @map("invalid_rows")
  createdRows    Int       @default(0) @map("created_rows")
  updatedRows    Int       @default(0) @map("updated_rows")
  skippedRows    Int       @default(0) @map("skipped_rows")
  /// Errores por fila del último análisis (para el reporte descargable)
  errors         Json      @default("[]")
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

// ---------------------------------------------------------------------------
// Fase 3 — Prospectos, negociaciones, productos asociados y comentarios (RLS)
// ---------------------------------------------------------------------------

model Lead {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String    @db.VarChar(20)
  title          String    @db.VarChar(200)
  contactId      String?   @map("contact_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  phone          String?   @db.VarChar(30)
  email          String?   @db.VarChar(254)
  emailNorm      String?   @map("email_norm") @db.VarChar(254)
  sourceId       String?   @map("source_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  stageId        String    @map("stage_id") @db.Uuid
  /// Orden dentro de la columna del Kanban (fraccionario para insertar sin renumerar).
  stagePosition  Float     @default(0) @map("stage_position")
  stageChangedAt DateTime  @default(now()) @map("stage_changed_at") @db.Timestamptz(3)
  ownerId        String?   @map("owner_id") @db.Uuid
  priorityId     String?   @map("priority_id") @db.Uuid
  currencyCode   String    @map("currency_code") @db.Char(3)
  estimatedValue Decimal?  @map("estimated_value") @db.Decimal(20, 4)
  /// Totales de los productos de interés, en la moneda del prospecto (guardados, no recalculados al leer).
  subtotal       Decimal   @default(0) @db.Decimal(20, 4)
  discount       Decimal   @default(0) @db.Decimal(20, 4)
  total          Decimal   @default(0) @db.Decimal(20, 4)
  notes          String?
  lossReasonId   String?   @map("loss_reason_id") @db.Uuid
  lossNote       String?   @map("loss_note") @db.VarChar(1000)
  convertedAt    DateTime? @map("converted_at") @db.Timestamptz(3)
  customFields   Json      @default("{}") @map("custom_fields")
  searchNorm     String    @default("") @map("search_norm")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?   @map("deleted_by_id") @db.Uuid

  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source     LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage      Stage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  priority   Priority?     @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  lossReason LossReason?   @relation(fields: [lossReasonId], references: [id], onDelete: Restrict)
  currency   Currency      @relation(fields: [organizationId, currencyCode], references: [organizationId, code], onDelete: Restrict)
  products   LeadProduct[]
  deal       Deal?
  comments   Comment[]

  @@index([organizationId, pipelineId, stageId, stagePosition])
  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, ownerId])
  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid(7)) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  code              String    @db.VarChar(20)
  title             String    @db.VarChar(200)
  /// Prospecto del que proviene (único: un prospecto se convierte una sola vez).
  sourceLeadId      String?   @unique @map("source_lead_id") @db.Uuid
  companyId         String?   @map("company_id") @db.Uuid
  pipelineId        String    @map("pipeline_id") @db.Uuid
  stageId           String    @map("stage_id") @db.Uuid
  stagePosition     Float     @default(0) @map("stage_position")
  stageChangedAt    DateTime  @default(now()) @map("stage_changed_at") @db.Timestamptz(3)
  ownerId           String?   @map("owner_id") @db.Uuid
  priorityId        String?   @map("priority_id") @db.Uuid
  currencyCode      String    @map("currency_code") @db.Char(3)
  estimatedValue    Decimal?  @map("estimated_value") @db.Decimal(20, 4)
  subtotal          Decimal   @default(0) @db.Decimal(20, 4)
  discount          Decimal   @default(0) @db.Decimal(20, 4)
  total             Decimal   @default(0) @db.Decimal(20, 4)
  finalValue        Decimal?  @map("final_value") @db.Decimal(20, 4)
  probability       Int?
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  /// OPEN | WON | LOST (sigue al tipo de la etapa)
  status            String    @default("OPEN") @db.VarChar(6)
  closedAt          DateTime? @map("closed_at") @db.Date
  lossReasonId      String?   @map("loss_reason_id") @db.Uuid
  lossNote          String?   @map("loss_note") @db.VarChar(1000)
  notes             String?
  customFields      Json      @default("{}") @map("custom_fields")
  searchNorm        String    @default("") @map("search_norm")
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?   @map("created_by_id") @db.Uuid
  updatedById       String?   @map("updated_by_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById       String?   @map("deleted_by_id") @db.Uuid

  sourceLead Lead?         @relation(fields: [sourceLeadId], references: [id], onDelete: Restrict)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage      Stage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  owner      User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  priority   Priority?     @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  lossReason LossReason?   @relation(fields: [lossReasonId], references: [id], onDelete: Restrict)
  currency   Currency      @relation(fields: [organizationId, currencyCode], references: [organizationId, code], onDelete: Restrict)
  contacts   DealContact[]
  products   DealProduct[]
  comments   Comment[]

  @@index([organizationId, pipelineId, stageId, stagePosition])
  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, ownerId])
  @@index([organizationId, status, closedAt])
  @@map("deals")
}

model DealContact {
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  @@id([dealId, contactId])
  @@index([organizationId, contactId])
  @@map("deal_contacts")
}

/// Producto de interés de un prospecto. Copia los valores comerciales: no cambia si cambia el catálogo.
model LeadProduct {
  id               String    @id @default(uuid(7)) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  position         Int       @default(0)
  sku              String    @db.VarChar(60)
  description      String    @db.VarChar(500)
  quantity         Decimal   @db.Decimal(18, 4)
  unitPrice        Decimal   @map("unit_price") @db.Decimal(20, 4)
  /// Moneda original del precio
  currencyCode     String    @map("currency_code") @db.Char(3)
  /// AMOUNT | PERCENT
  discountType     String    @default("PERCENT") @map("discount_type") @db.VarChar(8)
  discountValue    Decimal   @default(0) @map("discount_value") @db.Decimal(20, 4)
  /// Tasa aplicada (1 si la moneda coincide) y su origen
  exchangeRate     Decimal   @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  exchangeRateDate DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateId   String?   @map("exchange_rate_id") @db.Uuid
  /// MASTER | INVERSE | MANUAL | NONE
  rateSource       String    @default("NONE") @map("rate_source") @db.VarChar(8)
  rateReason       String?   @map("rate_reason") @db.VarChar(300)
  /// Importes en la moneda del prospecto, redondeados a sus decimales
  lineSubtotal     Decimal   @map("line_subtotal") @db.Decimal(20, 4)
  lineDiscount     Decimal   @map("line_discount") @db.Decimal(20, 4)
  lineTotal        Decimal   @map("line_total") @db.Decimal(20, 4)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, leadId, position])
  @@index([organizationId, productId])
  @@map("lead_products")
}

model DealProduct {
  id                  String    @id @default(uuid(7)) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  dealId              String    @map("deal_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  sourceLeadProductId String?   @map("source_lead_product_id") @db.Uuid
  position            Int       @default(0)
  sku                 String    @db.VarChar(60)
  description         String    @db.VarChar(500)
  quantity            Decimal   @db.Decimal(18, 4)
  unitPrice           Decimal   @map("unit_price") @db.Decimal(20, 4)
  currencyCode        String    @map("currency_code") @db.Char(3)
  discountType        String    @default("PERCENT") @map("discount_type") @db.VarChar(8)
  discountValue       Decimal   @default(0) @map("discount_value") @db.Decimal(20, 4)
  exchangeRate        Decimal   @default(1) @map("exchange_rate") @db.Decimal(20, 10)
  exchangeRateDate    DateTime? @map("exchange_rate_date") @db.Date
  exchangeRateId      String?   @map("exchange_rate_id") @db.Uuid
  rateSource          String    @default("NONE") @map("rate_source") @db.VarChar(8)
  rateReason          String?   @map("rate_reason") @db.VarChar(300)
  lineSubtotal        Decimal   @map("line_subtotal") @db.Decimal(20, 4)
  lineDiscount        Decimal   @map("line_discount") @db.Decimal(20, 4)
  lineTotal           Decimal   @map("line_total") @db.Decimal(20, 4)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId, dealId, position])
  @@index([organizationId, productId])
  @@map("deal_products")
}

model Comment {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  leadId         String?   @map("lead_id") @db.Uuid
  dealId         String?   @map("deal_id") @db.Uuid
  contactId      String?   @map("contact_id") @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  body           String
  authorId       String    @map("author_id") @db.Uuid
  mentions       String[]  @default([]) @db.Uuid
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@index([organizationId, dealId, createdAt])
  @@index([organizationId, contactId, createdAt])
  @@index([organizationId, companyId, createdAt])
  @@map("comments")
}
