{
  "name": "@crm/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "worker:dev": "nest start --watch --entryFile worker",
    "worker": "node dist/worker.js",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.check.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:setup": "tsx --env-file-if-exists=.env scripts/db-setup.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/throttler": "6.4.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "5.6.0",
    "csv-stringify": "6.5.2",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "nestjs-pino": "4.4.0",
    "nodemailer": "7.0.6",
    "pg-boss": "10.3.2",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@swc/cli": "0.7.8",
    "@swc/core": "1.13.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.1",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.1",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.4"
  }
}
