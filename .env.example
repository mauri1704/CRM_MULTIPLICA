# ---------------------------------------------------------------------------
# CRM Multiplica — variables de entorno. Copiar a apps/api/.env y completar.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Rol dueño del esquema: SOLO lo usan las migraciones, el seed y la cola (pg-boss).
DATABASE_URL=postgresql://crm:crm@localhost:5435/crm
# Rol de la aplicación (sin superusuario, sin BYPASSRLS): lo crea `pnpm db:setup`.
APP_DATABASE_URL=postgresql://crm_app:crm_app@localhost:5435/crm
# Contraseña con la que `pnpm db:setup` crea el rol crm_app (debe coincidir con APP_DATABASE_URL).
APP_DB_PASSWORD=crm_app

# Base de datos de las pruebas de integración (se borra y recrea en cada corrida).
TEST_DATABASE_URL=postgresql://crm:crm@localhost:5435/crm_test
TEST_APP_DATABASE_URL=postgresql://crm_app:crm_app@localhost:5435/crm_test

API_PORT=3001
# URL pública de la interfaz: se usa en los enlaces de los correos.
WEB_URL=http://localhost:5173

# Correo saliente (recuperar contraseña). Formato: smtp://usuario:clave@host:587
# Vacío en desarrollo: el enlace se escribe en el log de la API (nunca en producción).
SMTP_URL=
MAIL_FROM="CRM Multiplica <no-reply@multiplica.test>"

# Intentos por minuto y por IP en login y recuperación de contraseña.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Directorio de archivos (importaciones/exportaciones; se usa desde la Fase 2).
STORAGE_DIR=./storage
